{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug openocd",
            "cwd": "${workspaceFolder}/build/app",
            "executable": "./nrf905_stm32l4_transceiver.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": ["board/st_nucleo_l4.cfg"],
            "device": "STM32L476RG", // with device support pack
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            // "svdFile": "${workspaceFolder}/STM32L4x6.svd", // without device support pack
        },
        {
            "name": "debug jlink",
            "cwd": "${workspaceFolder}/build/app",
            "executable": "./nrf905_stm32l4_transceiver.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "device": "STM32L476RG", // with device support pack
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            // "svdFile": "${workspaceFolder}/STM32L4x6.svd", // without device support pack
        },
        {
            "name": "debug MS openocd",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/app",
            "program": "${workspaceFolder}/build/app/nrf905_stm32l4_transceiver.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "openocd",
            "debugServerArgs": "-f board/st_nucleo_l4.cfg",
            "serverStarted": "Listening on port .* for gdb connections",
            "filterStderr": true,
            "stopAtConnect": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 6
            },
            "svdPath": "${workspaceFolder}/STM32L4x6.svd",
            "preLaunchTask": "flash openocd"
        },
        {
            "name": "debug MS jlink",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/app",
            "program": "${workspaceFolder}/build/app/nrf905_stm32l4_transceiver.elf",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "C:/embedded_tools/SEGGER/JLink_V796k/JLinkGDBServerCL.exe",
            "debugServerArgs": "-if swd -speed 4000 -endian little -port 3333 -device STM32L476RG -nogui -x ${workspaceFolder}/.vscode/reset.gdb",
            "serverStarted": "Connected to target",
            "filterStdout": true,
            "stopAtConnect": true,
            "setupCommands": [
                { 
                    "description": "Allow reading of peripheral registers", "text": "set mem inaccessible-by-default off", "ignoreFailures": true
                }
            ],
            "launchCompleteCommand": "exec-continue",
            "svdPath": "${workspaceFolder}/STM32L4x6.svd",
            "preLaunchTask": "flash jlink"
        }
    ]
}
