{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake --preset v0.0.1_debug",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build --preset v0.0.1_debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
              }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmake --build build --target clean --parallel",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "flash openocd",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build/app"
            },
            "command": "openocd -f board/st_nucleo_l4.cfg -c \"program nrf905_stm32l4_transceiver.elf verify\" -c \"reset halt\" -c shutdown",
        },
        {
            "label": "flash jlink",
            "type": "shell",
            "command": "jlink -if swd -speed 4000 -device STM32L476RG -commanderscript .vscode/flash.jlink",
        },
    ]
}
